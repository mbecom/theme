adding_top":36,"desktop_padding_bottom":36}},"related-products":{"type":"related-products","disabled":true,"settings":{"display_id":false,"title":"You may also like","title_highlight_color":"#6d388b","heading_size":"h2","products_to_show":4,"columns_desktop":4,"color_scheme":"background-1","image_ratio":"adapt","show_secondary_image":false,"show_vendor":false,"show_rating":false,"enable_quick_add":false,"columns_mobile":"2","padding_top":36,"padding_bottom":24}},"8beb6911-28c6-482c-976a-e5421ad3e8df":{"type":"custom-columns","blocks":{"template--21507361800487__8beb6911-28c6-482c-976a-e5421ad3e8df-icon_with_text-1":{"type":"icon_with_text","settings":{"column":"col_1","visibility":"always-display","icon":"water_drop","filled_icon":true,"icon_size":"m","icon_position":"above","icon_color":"accent-1","icon_heading_size":"h4","icon_text_alignment":"center","title":"Ultra Sec","text":"<p>Profitez d'une prise en main parfaite avec notre formule anti-transpirante.<\/p>","margin_top":20,"margin_bottom":30}},"icon_with_text_hkQWAN":{"type":"icon_with_text","settings":{"column":"col_1","visibility":"always-display","icon":"timer","filled_icon":true,"icon_size":"m","icon_position":"above","icon_color":"accent-1","icon_heading_size":"h4","icon_text_alignment":"center","title":"Tenue longue","text":"<p>Une dose avant votre partie suffira pour tenir plusieurs sets<\/p>","margin_top":20,"margin_bottom":30}},"icon_with_text_gdFqzr":{"type":"icon_with_text","settings":{"column":"col_1","visibility":"always-display","icon":"laundry","filled_icon":true,"icon_size":"m","icon_position":"above","icon_color":"accent-1","icon_heading_size":"h4","icon_text_alignment":"center","title":"Pas de taches","text":"<p>Malgré le fait que ça soit du gel, une fois appliqué sur les mains et sec, il n'y aura pas de traces sur vos tenues de sport<\/p>","margin_top":20,"margin_bottom":30}}},"block_order":["template--21507361800487__8beb6911-28c6-482c-976a-e5421ad3e8df-icon_with_text-1","icon_with_text_hkQWAN","icon_with_text_gdFqzr"],"settings":{"display_id":false,"visibility":"always-display","color_scheme":"background-1","columns_count":4,"column_gap_desktop":40,"row_gap_desktop":40,"desktop_vertical_alignment":"center","column_gap_mobile":20,"row_gap_mobile":30,"mobile_vertical_alignment":"flex-start","col_1_desktop_width":12,"col_1_mobile_width":4,"col_1_visibility":"always-display","col_2_desktop_width":4,"col_2_mobile_width":4,"col_2_visibility":"always-display","col_3_desktop_width":4,"col_3_mobile_width":4,"col_3_visibility":"always-display","col_4_desktop_width":4,"col_4_mobile_width":4,"col_4_visibility":"always-display","col_5_desktop_width":3,"col_5_mobile_width":4,"col_5_visibility":"always-display","col_6_desktop_width":3,"col_6_mobile_width":4,"col_6_visibility":"always-display","padding_top":20,"padding_bottom":0,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d"}},"55bd100e-3bbd-426c-a5cf-eed7b2a3706f":{"type":"testimonials","blocks":{"template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-1":{"type":"column","settings":{"video":"shopify:\/\/files\/videos\/IMG_5158.MOV","star_rating":5,"title":"Gel PureGrip","text":"<p>Top ! Je ne savais pas que ça existait mais l'effet est vraiment incroyable. Les mains sont sèches en quelques secondes et après plus aucun problème de tenue de raquette dans la partie.<\/p>","author":"<strong>Enzo<\/strong>, joueur de padel 1x\/semaine"}},"template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-2":{"type":"column","settings":{"star_rating":5,"title":"Une vraie différence sur mes sensations de jeu.","text":"<p>J’étais sceptique au début, mais le surgrip Absorbent Pro m’a bluffé. On sent tout de suite que le matériau est plus technique que les surgrips classiques. J’ai gagné en relâchement et en contrôle à la volée.<\/p>","author":"<strong>Hugo<\/strong>, 15\/2 au tennis"}},"template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-3":{"type":"column","settings":{"star_rating":5,"title":"Très efficace","text":"<p>Je joue régulièrement au tennis et j’avais souvent le manche qui me glissait en été. Avec ce gel, je sens vraiment la différence : ça sèche vite, ça ne colle pas et une petite dose suffit largement. J’ai la peau sensible et je n’ai eu aucune réaction. Franchement, ça aide bien.<\/p>","author":"<strong>Antoine<\/strong>, ancien joueur blessé"}}},"block_order":["template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-1","template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-2","template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-3"],"settings":{"display_id":false,"visibility":"always-display","title":"Avis clients","title_highlight_color":"#6d388b","heading_size":"h1","text":"","color_scheme":"background-1","image_width":"full","image_ratio":"square","column_alignment":"center","show_stars":true,"inactive_stars_style":"solid","star_color":"#ffcc00","bg_star_color":"#ececec","show_quotes":true,"quotes_color_scheme":"accent-2","cards_color_scheme":"bg-overlay","type":"slide","autoplay":false,"autoplay_speed":5,"arrows_color_scheme":"inverse","transparent_arrows":true,"dots_color_scheme":"inverse","desktop_full_page":false,"columns_desktop":3,"slider_desktop":false,"per_move_desktop":1,"desktop_spacing":40,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":false,"desktop_dots_position":"under","desktop_arrows_position":"sides","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":false,"mobile_dots_position":"hidden","mobile_arrows_position":"sides","padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_cards_colors_background":"#f3f3f3","custom_cards_gradient_backgroun