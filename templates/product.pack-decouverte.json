olor_scheme":"background-1","image_ratio":"adapt","show_secondary_image":false,"show_vendor":false,"show_rating":false,"enable_quick_add":false,"columns_mobile":"2","padding_top":36,"padding_bottom":24}},"8beb6911-28c6-482c-976a-e5421ad3e8df":{"type":"custom-columns","blocks":{"template--21507361800487__8beb6911-28c6-482c-976a-e5421ad3e8df-icon_with_text-1":{"type":"icon_with_text","settings":{"column":"col_1","visibility":"always-display","icon":"water_drop","filled_icon":true,"icon_size":"m","icon_position":"above","icon_color":"accent-1","icon_heading_size":"h4","icon_text_alignment":"center","title":"Ultra Sec","text":"<p>Profitez d'une prise en main parfaite avec notre formule anti-transpirante.<\/p>","margin_top":20,"margin_bottom":30}},"icon_with_text_hkQWAN":{"type":"icon_with_text","settings":{"column":"col_1","visibility":"always-display","icon":"timer","filled_icon":true,"icon_size":"m","icon_position":"above","icon_color":"accent-1","icon_heading_size":"h4","icon_text_alignment":"center","title":"Tenue longue","text":"<p>Une dose avant votre partie suffira pour tenir plusieurs sets<\/p>","margin_top":20,"margin_bottom":30}},"icon_with_text_gdFqzr":{"type":"icon_with_text","settings":{"column":"col_1","visibility":"always-display","icon":"favorite","filled_icon":true,"icon_size":"m","icon_position":"above","icon_color":"accent-1","icon_heading_size":"h4","icon_text_alignment":"center","title":"Confortable","text":"<p>Avec ses 0.65mm d'épaisseur, ce surgrip absorbant vous donnera un confort parfait<\/p>","margin_top":20,"margin_bottom":30}}},"block_order":["template--21507361800487__8beb6911-28c6-482c-976a-e5421ad3e8df-icon_with_text-1","icon_with_text_hkQWAN","icon_with_text_gdFqzr"],"settings":{"display_id":false,"visibility":"always-display","color_scheme":"background-1","columns_count":4,"column_gap_desktop":40,"row_gap_desktop":40,"desktop_vertical_alignment":"center","column_gap_mobile":20,"row_gap_mobile":30,"mobile_vertical_alignment":"flex-start","col_1_desktop_width":12,"col_1_mobile_width":4,"col_1_visibility":"always-display","col_2_desktop_width":4,"col_2_mobile_width":4,"col_2_visibility":"always-display","col_3_desktop_width":4,"col_3_mobile_width":4,"col_3_visibility":"always-display","col_4_desktop_width":4,"col_4_mobile_width":4,"col_4_visibility":"always-display","col_5_desktop_width":3,"col_5_mobile_width":4,"col_5_visibility":"always-display","col_6_desktop_width":3,"col_6_mobile_width":4,"col_6_visibility":"always-display","padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d"}},"55bd100e-3bbd-426c-a5cf-eed7b2a3706f":{"type":"testimonials","blocks":{"template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-1":{"type":"column","settings":{"star_rating":5,"title":"Vraiment top !","text":"<p>J’ai toujours eu du mal à trouver un surgrip qui ne glisse pas au bout de 20 minutes… Maintenant je sens vraiment que ça tient, même quand je transpire beaucoup. Le confort est top, je n’ai plus de douleurs dans l’avant-bras comme avant. Je recommande à 100 %.<\/p>","author":"<strong>Julien<\/strong>, joueur de padel 3x\/semaine"}},"template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-2":{"type":"column","settings":{"star_rating":5,"title":"Une vraie différence sur mes sensations de jeu.","text":"<p>J’étais sceptique au début, mais le surgrip Absorbent Pro m’a bluffé. On sent tout de suite que le matériau est plus technique que les surgrips classiques. J’ai gagné en relâchement et en contrôle à la volée.<\/p>","author":"<strong>Claire<\/strong>, classée 15\/2 au tennis"}},"template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-3":{"type":"column","settings":{"star_rating":5,"title":"Mon kiné m’a conseillé Gripium..","text":"<p>Tendinite au poignet à répétition depuis un an… Mon kiné m’a expliqué que ça pouvait venir d’un mauvais grip. J’ai essayé Gripium avec un modèle plus épais et amortissant : plus aucune douleur depuis 3 semaines. Merci encore !<\/p>","author":"<strong>Antoine<\/strong>, ancien joueur blessé"}}},"block_order":["template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-1","template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-2","template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-3"],"settings":{"display_id":false,"visibility":"always-display","title":"Avis clients","title_highlight_color":"#6d388b","heading_size":"h1","text":"","color_scheme":"background-1","image_width":"full","image_ratio":"square","column_alignment":"center","show_stars":true,"inactive_stars_style":"solid","star_color":"#ffcc00","bg_star_color":"#ececec","show_quotes":true,"quotes_color_scheme":"accent-2","cards_color_scheme":"bg-overlay","type":"slide","autoplay":false,"autoplay_speed":5,"arrows_color_scheme":"inverse","transparent_arrows":true,"dots_color_scheme":"inverse","desktop_full_page":false,"columns_desktop":3,"slider_desktop":false,"per_move_desktop":1,"desktop_spacing":40,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":false,"desktop_dots_position":"under","desktop_arrows_position":"sides","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":false,"mobile_dots_position":"hidden","mobile_arrows_position":"sides","padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_cards_colors_background":"#f3f3f3","custom_cards_gradient_background":"","custom_cards_colors_text":"#2e2a39"}}},"order":["main","related-products","8beb6911-28c6-482c-976a-e5421ad3e8df","55bd100e-3bbd-426c-a5cf-eed7b2a3706f"]}